<div class="flex items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold">Teorija</h1>
    <p class="text-slate-600 mt-1">Filtruokite pagal temą.</p>
  </div>

  <form method="get" action="/app/teorija" class="flex gap-2 flex-wrap justify-end">
    <input
      name="q"
      placeholder="Ieškoti teorijoje…"
      class="px-3 py-2 rounded border border-slate-300 bg-white"
      value="<%= typeof q === 'string' ? q : '' %>"
    />
    <select name="tema" class="px-3 py-2 rounded border border-slate-300 bg-white">
      <option value="">Visos temos</option>
      <% topics.forEach((t) => { %>
        <option value="<%= t.id %>" <%= String(topicId||'') === String(t.id) ? 'selected' : '' %>><%= t.title %></option>
      <% }) %>
    </select>
    <button class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800">Filtruoti</button>
  </form>
</div>

<div class="mt-6 space-y-2">
  <% if (!theory.length) { %>
    <div class="text-sm text-slate-600">Teorijos įrašų nėra.</div>
  <% } %>
  <% theory.forEach((p) => { %>
    <a class="block bg-white border border-slate-200 rounded-lg p-4 hover:bg-slate-50" href="/app/teorija/<%= p.id %>">
      <div class="text-xs text-slate-500"><%= p.topic_title %> • <%= p.updated_at %></div>
      <div class="font-semibold"><%= p.title %></div>
      <% if (p.short_description) { %><div class="text-sm text-slate-600 mt-1"><%= p.short_description %></div><% } %>
    </a>
  <% }) %>
</div>

