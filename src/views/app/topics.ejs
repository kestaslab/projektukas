<div class="flex items-center justify-between gap-3">
  <div>
    <h1 class="text-2xl font-semibold">Temos</h1>
    <p class="text-slate-600 mt-1">Filtruokite pagal temų grupę.</p>
  </div>

  <form method="get" action="/app/temos" class="flex gap-2">
    <select name="grupe" class="px-3 py-2 rounded border border-slate-300 bg-white">
      <option value="">Visos grupės</option>
      <% groups.forEach((g) => { %>
        <option value="<%= g.id %>" <%= String(groupId||'') === String(g.id) ? 'selected' : '' %>><%= g.title %></option>
      <% }) %>
    </select>
    <button class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800">Filtruoti</button>
  </form>
</div>

<div class="mt-6 space-y-2">
  <% if (!topics.length) { %>
    <div class="text-sm text-slate-600">Temų nėra.</div>
  <% } %>
  <% topics.forEach((t) => { %>
    <a class="block bg-white border border-slate-200 rounded-lg p-4 hover:bg-slate-50" href="/app/tema/<%= t.id %>">
      <div class="text-xs text-slate-500"><%= t.group_title %></div>
      <div class="font-semibold"><%= t.title %></div>
      <% if (t.short_description) { %><div class="text-sm text-slate-600 mt-1"><%= t.short_description %></div><% } %>
    </a>
  <% }) %>
</div>

