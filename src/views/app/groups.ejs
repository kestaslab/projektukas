<h1 class="text-2xl font-semibold">Temų grupės</h1>
<p class="text-slate-600 mt-1">Grupės skirtos temoms suskirstyti.</p>

<div class="grid md:grid-cols-2 gap-4 mt-6">
  <% groups.forEach((g) => { %>
    <div class="bg-white border border-slate-200 rounded-lg p-4">
      <div class="font-semibold"><%= g.title %></div>
      <% if (g.description) { %><div class="text-sm text-slate-600 mt-1"><%= g.description %></div><% } %>
      <div class="mt-3">
        <a class="inline-flex px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800" href="/app/temos?grupe=<%= g.id %>">Peržiūrėti temas</a>
      </div>
    </div>
  <% }) %>
</div>

