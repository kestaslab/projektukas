<section class="welcome">
  <div>
    <div class="eyebrow">Visas C++ kursas</div>
    <h1>C++ programavimo pagrindai (visa medžiaga)</h1>
    <p>19 originalių PROGMIS kurso temų ta pačia tvarka. Įkelta teorija, pavyzdžiai ir užduotys vienoje vietoje.</p>
    <p class="mt-3"><%= topics.length %> temos · <%= theoryCount %> teorijos įrašai · <%= taskCount %> vietinių užduočių</p>
  </div>
  <div class="welcome-symbol" aria-hidden="true">{ }</div>
</section>
<nav class="bg-white border border-slate-200 rounded-lg p-5 mt-6" aria-label="Kurso turinys">
  <h2 class="font-semibold mb-3">Kurso turinys</h2>
  <ol class="grid md:grid-cols-2 gap-x-6 gap-y-2">
    <% topics.forEach((topic, i) => { %>
      <li><a class="text-sm underline" href="#kurso-tema-<%= topic.id %>"><%= i + 1 %>. <%= topic.title %></a><% if (topic.is_current) { %> <span class="current-badge">Einama</span><% } %></li>
    <% }) %>
  </ol>
</nav>
<% if (!topics.length) { %><p class="mt-6">Kurso temos dar ruošiamos.</p><% } %>
<% topics.forEach((topic, i) => { %>
<section id="kurso-tema-<%= topic.id %>" class="bg-white border border-slate-200 rounded-lg p-5 mt-5" style="scroll-margin-top:100px" aria-labelledby="kurso-pavadinimas-<%= topic.id %>">
  <div class="eyebrow">Tema <%= String(i + 1).padStart(2, '0') %></div>
  <h2 id="kurso-pavadinimas-<%= topic.id %>" class="text-xl font-semibold mt-2"><%= topic.title %><% if (topic.is_current) { %> <span class="current-badge">Einama</span><% } %></h2>
  
  <details class="mt-4">
    <summary class="cursor-pointer font-medium">Teorija (<%= topic.theory.length %>) ir užduotys (<%= topic.tasks.length %>)</summary>
    <div class="grid md:grid-cols-2 gap-6 mt-4">
      <div><h3 class="font-semibold mb-2">Teorija</h3>
        <% if (!topic.theory.length) { %><p class="text-sm text-slate-500">Šios temos teorija dar neįkelta.</p><% } %>
        <% topic.theory.forEach(page => { %><a class="content-row" href="/app/teorija/<%= page.id %>"><span class="row-icon" aria-hidden="true">Aa</span><span class="row-title"><%= page.title %></span></a><% }) %>
      </div>
      <div><h3 class="font-semibold mb-2">Užduotys</h3>
        <% if (!topic.tasks.length) { %><p class="text-sm text-slate-500">Užduotys ruošiamos.</p><% } %>
        <% topic.tasks.forEach(task => { %><a class="content-row" href="/app/uzduotis/<%= task.id %>"><span class="row-icon task" aria-hidden="true">&lt;/&gt;</span><span><span class="row-title"><%= task.title %></span><% if (task.external_url) { %><span class="row-meta block">Vietinė sąlyga dar neįkelta</span><% } %></span></a><% }) %>
      </div>
    </div>
  </details>
  <div class="share-controls mt-4">
    <button type="button" class="px-3 py-2 rounded bg-slate-900 text-white" data-share-topic="/app/programavimo-pagrindai#kurso-tema-<%= topic.id %>">Dalintis tema</button>
    <span class="text-sm text-slate-600" role="status" aria-live="polite" data-share-status></span>
    <input class="share-link mt-2 w-full px-3 py-2 rounded border border-slate-300" type="text" readonly hidden aria-label="Temos nuoroda">
  </div>
</section>
<% }) %>

<script>
(function(){function openSharedTopic(){const id=location.hash.slice(1);if(!/^kurso-tema-\d+$/.test(id))return;const section=document.getElementById(id);if(section){const details=section.querySelector('details');if(details)details.open=true;}}openSharedTopic();window.addEventListener('hashchange',openSharedTopic);})();
</script>