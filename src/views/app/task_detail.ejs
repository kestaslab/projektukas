<div>
  <div class="text-xs text-slate-500"><%= task.topic_title %> • Lygis <%= task.difficulty %> • Atnaujinta <%= task.updated_at %></div>
  <h1 class="text-2xl font-semibold mt-1"><%= task.title %></h1>
  <% if (task.short_description) { %><p class="text-slate-600 mt-1"><%= task.short_description %></p><% } %>
</div>

<% if (task.external_url && task.external_url.startsWith('https://progmis.lt/task/') && !isNaN(Number(task.external_url.split('/').pop()))) { %>
<div class="mt-4 p-4 bg-white border border-slate-200 rounded-lg">
  <a class="primary-link" style="margin-top:0" href="<%= task.external_url %>" target="_blank" rel="noopener noreferrer">Atidaryti užduotį PROGMIS ↗</a>
  <p class="text-sm text-slate-500 mt-2">Sąlyga ir automatinis tikrinimas pateikiami PROGMIS. Gali reikėti prisijungimo ir atskiros prieigos.</p>
</div>
<% } %>
<div class="grid lg:grid-cols-3 gap-4 mt-6">
  <article class="lg:col-span-2 bg-white border border-slate-200 rounded-lg p-4 space-y-4">
    <section>
      <div class="font-semibold">Sąlyga</div>
      <% if (taskHtml) { %><div class="imported-content mt-2"><%- taskHtml.statement %></div><% } else { %><pre class="mt-2 whitespace-pre-wrap text-sm bg-slate-50 border border-slate-200 rounded p-3"><%= task.statement %></pre><% } %>
    </section>
    <% if (task.input_desc) { %>
      <section>
        <div class="font-semibold">Įvestis</div>
        <% if (taskHtml) { %><div class="imported-content mt-2"><%- taskHtml.input_desc %></div><% } else { %><pre class="mt-2 whitespace-pre-wrap text-sm bg-slate-50 border border-slate-200 rounded p-3"><%= task.input_desc %></pre><% } %>
      </section>
    <% } %>
    <% if (task.output_desc) { %>
      <section>
        <div class="font-semibold">Išvestis</div>
        <% if (taskHtml) { %><div class="imported-content mt-2"><%- taskHtml.output_desc %></div><% } else { %><pre class="mt-2 whitespace-pre-wrap text-sm bg-slate-50 border border-slate-200 rounded p-3"><%= task.output_desc %></pre><% } %>
      </section>
    <% } %>
    <% if (task.examples) { %>
      <section>
        <div class="font-semibold">Pavyzdžiai</div>
        <% if (taskHtml) { %><div class="imported-content mt-2"><%- taskHtml.examples %></div><% } else { %><pre class="mt-2 whitespace-pre-wrap text-sm bg-slate-50 border border-slate-200 rounded p-3"><%= task.examples %></pre><% } %>
      </section>
    <% } %>
    <% if (task.hint) { %>
      <section>
        <div class="font-semibold">Užuomina</div>
        <pre class="mt-2 whitespace-pre-wrap text-sm bg-slate-50 border border-slate-200 rounded p-3"><%= task.hint %></pre>
      </section>
    <% } %>
  </article>

  <aside class="space-y-4">
    <div class="bg-white border border-slate-200 rounded-lg p-4">
      <div class="font-semibold">Prisegti failai</div>
      <div class="mt-3 space-y-2 text-sm">
        <% if (!attachments.length) { %><div class="text-slate-600">Nėra.</div><% } %>
        <% attachments.forEach((f) => { %>
          <a class="block underline" href="/failai/atsisiusti/<%= f.id %>"><%= f.original_name %></a>
          <div class="text-xs text-slate-500"><%= f.mime_type %> • <%= f.size_bytes %> B • <%= f.uploaded_at %></div>
        <% }) %>
      </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-lg p-4">
      <div class="font-semibold">Susijusi teorija</div>
      <div class="mt-3 space-y-2 text-sm">
        <% if (!relatedTheory.length) { %><div class="text-slate-600">Nėra.</div><% } %>
        <% relatedTheory.forEach((p) => { %>
          <a class="block underline" href="/app/teorija/<%= p.id %>"><%= p.title %></a>
        <% }) %>
      </div>
    </div>
  </aside>
</div>


<%- include('cpp_editor', { task }) %>
