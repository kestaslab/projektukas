<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold">Pradžia</h1>
    <p class="text-slate-600 mt-1">Naujausia teorija ir užduotys.</p>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-4 mt-6">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="font-semibold">Naujausia teorija</div>
    <div class="mt-3 space-y-2">
      <% if (!latestTheory.length) { %>
        <div class="text-sm text-slate-600">Kol kas nėra įrašų.</div>
      <% } %>
      <% latestTheory.forEach((t) => { %>
        <a class="block p-3 rounded hover:bg-slate-50 border border-slate-100" href="/app/teorija/<%= t.id %>">
          <div class="font-medium"><%= t.title %></div>
          <div class="text-xs text-slate-500 mt-1"><%= t.topic_title %> • <%= t.updated_at %></div>
        </a>
      <% }) %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="font-semibold">Naujausios užduotys</div>
    <div class="mt-3 space-y-2">
      <% if (!latestTasks.length) { %>
        <div class="text-sm text-slate-600">Kol kas nėra įrašų.</div>
      <% } %>
      <% latestTasks.forEach((t) => { %>
        <a class="block p-3 rounded hover:bg-slate-50 border border-slate-100" href="/app/uzduotis/<%= t.id %>">
          <div class="font-medium"><%= t.title %></div>
          <div class="text-xs text-slate-500 mt-1"><%= t.topic_title %> • Lygis <%= t.difficulty %> • <%= t.updated_at %></div>
        </a>
      <% }) %>
    </div>
  </div>
</div>

