<h1 class="text-2xl font-semibold">Paieška</h1>
<p class="text-slate-600 mt-1">Užklausa: <span class="font-medium"><%= q || '(tuščia)' %></span></p>

<div class="grid md:grid-cols-2 gap-4 mt-6">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="font-semibold">Teorija</div>
    <div class="mt-3 space-y-2">
      <% if (!theory.length) { %><div class="text-sm text-slate-600">Nėra rezultatų.</div><% } %>
      <% theory.forEach((p) => { %>
        <a class="block p-3 rounded hover:bg-slate-50 border border-slate-100" href="/app/teorija/<%= p.id %>">
          <div class="font-medium"><%= p.title %></div>
          <div class="text-xs text-slate-500 mt-1"><%= p.topic_title %> • <%= p.updated_at %></div>
        </a>
      <% }) %>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <div class="font-semibold">Užduotys</div>
    <div class="mt-3 space-y-2">
      <% if (!tasks.length) { %><div class="text-sm text-slate-600">Nėra rezultatų.</div><% } %>
      <% tasks.forEach((u) => { %>
        <a class="block p-3 rounded hover:bg-slate-50 border border-slate-100" href="/app/uzduotis/<%= u.id %>">
          <div class="font-medium"><%= u.title %></div>
          <div class="text-xs text-slate-500 mt-1"><%= u.topic_title %> • Lygis <%= u.difficulty %> • <%= u.updated_at %></div>
        </a>
      <% }) %>
    </div>
  </div>
</div>

