<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold"><%= mode === 'create' ? 'Naujas vartotojas' : 'Redaguoti vartotoją' %></h1>
    <p class="text-slate-600 mt-1">Prisijungimas su vartotojo vardu ir slaptažodžiu.</p>
  </div>
  <a class="underline" href="/admin/vartotojai">Grįžti į sąrašą</a>
</div>

<% if (error) { %>
  <div class="mt-4 p-3 rounded border border-red-200 bg-red-50 text-red-800 text-sm"><%= error %></div>
<% } %>

<div class="grid lg:grid-cols-3 gap-4 mt-6">
  <div class="lg:col-span-2 bg-white border border-slate-200 rounded-lg p-6">
    <form method="post" action="<%= mode === 'create' ? '/admin/vartotojai/naujas' : ('/admin/vartotojai/' + user.id) %>" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-sm font-medium">Vartotojo vardas</label>
        <input
          name="username"
          class="mt-1 w-full px-3 py-2 rounded border border-slate-300"
          value="<%= user.username %>"
          <%= mode === 'edit' ? 'readonly' : '' %>
        />
        <% if (mode === 'edit') { %><div class="text-xs text-slate-500 mt-1">Vartotojo vardo keisti nerekomenduojama.</div><% } %>
      </div>

      <div>
        <label class="block text-sm font-medium">Vardas / pavardė</label>
        <input name="full_name" class="mt-1 w-full px-3 py-2 rounded border border-slate-300" value="<%= user.full_name %>" />
      </div>

      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium">Rolė</label>
          <select name="role" class="mt-1 w-full px-3 py-2 rounded border border-slate-300 bg-white">
            <option value="student" <%= user.role === 'student' ? 'selected' : '' %>>Mokinys</option>
            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin / mokytojas</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium">Aktyvus</label>
          <select name="is_active" class="mt-1 w-full px-3 py-2 rounded border border-slate-300 bg-white">
            <option value="1" <%= user.is_active ? 'selected' : '' %>>Taip</option>
            <option value="0" <%= !user.is_active ? 'selected' : '' %>>Ne</option>
          </select>
        </div>
      </div>

      <% if (mode === 'create') { %>
        <div>
          <label class="block text-sm font-medium">Laikinas slaptažodis</label>
          <input name="password" class="mt-1 w-full px-3 py-2 rounded border border-slate-300" value="<%= tempPassword %>" />
          <div class="text-xs text-slate-500 mt-1">Mokinys galės naudoti šį slaptažodį prisijungimui.</div>
        </div>
      <% } %>

      <button class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800">
        <%= mode === 'create' ? 'Sukurti' : 'Išsaugoti' %>
      </button>
    </form>
  </div>

  <% if (mode === 'edit') { %>
    <div class="space-y-4">
      <div class="bg-white border border-slate-200 rounded-lg p-6">
        <div class="font-semibold">Keisti slaptažodį</div>
        <form class="mt-3 space-y-2" method="post" action="/admin/vartotojai/<%= user.id %>/slaptazodis">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="password" class="w-full px-3 py-2 rounded border border-slate-300" placeholder="Naujas slaptažodis" />
          <button class="w-full px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800">Atnaujinti</button>
        </form>
      </div>

      <div class="bg-white border border-slate-200 rounded-lg p-6">
        <div class="font-semibold text-red-700">Trinti vartotoją</div>
        <p class="text-sm text-slate-600 mt-1">Atsargiai: vartotojas bus ištrintas.</p>
        <form class="mt-3" method="post" action="/admin/vartotojai/<%= user.id %>/trinti" onsubmit="return confirm('Tikrai trinti?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="px-3 py-2 rounded border border-red-300 text-red-700 hover:bg-red-50">Trinti</button>
        </form>
      </div>
    </div>
  <% } %>
</div>

