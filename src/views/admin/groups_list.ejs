<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold">Temų grupės</h1>
    <p class="text-slate-600 mt-1">Grupės skirtos temoms suskirstyti.</p>
  </div>
  <a class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800" href="/admin/temu-grupes/nauja">+ Nauja</a>
</div>

<div class="bg-white border border-slate-200 rounded-lg mt-6 overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="text-left px-4 py-3">Pavadinimas</th>
        <th class="text-left px-4 py-3">Rikiavimas</th>
        <th class="text-left px-4 py-3">Aktyvi</th>
        <th class="text-left px-4 py-3">Atnaujinta</th>
        <th class="text-right px-4 py-3">Veiksmai</th>
      </tr>
    </thead>
    <tbody>
      <% groups.forEach((g) => { %>
        <tr class="border-t border-slate-200">
          <td class="px-4 py-3">
            <div class="font-medium"><%= g.title %></div>
            <% if (g.description) { %><div class="text-xs text-slate-500 mt-1"><%= g.description %></div><% } %>
          </td>
          <td class="px-4 py-3"><%= g.sort_order %></td>
          <td class="px-4 py-3"><%= g.is_active ? 'Taip' : 'Ne' %></td>
          <td class="px-4 py-3 text-slate-600"><%= g.updated_at %></td>
          <td class="px-4 py-3 text-right">
            <a class="underline" href="/admin/temu-grupes/<%= g.id %>">Redaguoti</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

