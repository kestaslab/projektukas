<h1 class="text-2xl font-semibold">Vietinės mokymosi medžiagos importas</h1>
<p class="mt-2 text-slate-600">Teorija, kodo pavyzdžiai ir užduočių sąlygos perkeliamos į programavimo temas. Pakartotinai pateikti įrašai nedubliuojami.</p>
<form id="local-import" class="mt-6 bg-white border border-slate-200 rounded-lg p-5 space-y-4">
  <label for="bundle" class="block font-medium">Paruoštas HTML medžiagos paketas</label>
  <input type="file" id="bundle" name="bundle" accept=".json">
  <details><summary class="cursor-pointer text-sm">Arba įklijuoti paruoštą medžiagą</summary><label class="block mt-3 text-sm" for="bundle-text">Importo paketo turinys</label><textarea id="bundle-text" name="bundle_text" rows="5" class="block w-full border rounded p-3 mt-2 font-mono text-xs" spellcheck="false"></textarea></details>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <p class="text-sm text-slate-500">Iki 5 MB. Prieš importuojant sukuriama duomenų bazės kopija. Esami mokinio sprendimai ir testai išlieka.</p>
  <button class="block bg-slate-900 text-white rounded px-4 py-2">Importuoti medžiagą</button>
</form>
<p id="import-status" role="status" aria-live="polite" class="mt-4 font-medium"></p>
<div id="import-report" class="mt-5">
<% if(report){ %>
  <h2 class="text-lg font-semibold">Paskutinio importo rezultatas</h2>
  <p class="mt-2">Naujos teorijos: <%= report.theory %>; naujos užduotys: <%= report.tasks %>; nuorodų pakeista vietiniu turiniu: <%= report.converted %>; pakartotinių įrašų praleista: <%= report.skipped %>.</p>
  <% if(report.changed){ %><p class="mt-2">Pakitusių failų neatnaujinta automatiškai: <%= report.changed %>. Esamas turinys išsaugotas.</p><% } %>
  <ul class="mt-3 space-y-1"><% report.sections.forEach(s=>{ %><li><%= s.title %>: <%= s.theory %> teorijos, <%= s.tasks %> užduočių.</li><% }) %></ul>
  <% if(report.gaps.length){ %><h3 class="font-semibold mt-4">Šių kurso dalių pateiktuose failuose nebuvo</h3><p class="text-sm mt-2"><%= report.gaps.join('; ') %></p><% } %>
<% } %>
</div>
<script>
(function(){const form=document.getElementById('local-import'),status=document.getElementById('import-status');form.addEventListener('submit',async function(e){e.preventDefault();const button=form.querySelector('button');button.disabled=true;status.textContent='Importuojama…';try{const response=await fetch('/admin/importas/progmis',{method:'POST',headers:{'X-CSRF-Token':form.elements._csrf.value},body:new FormData(form),credentials:'same-origin'});if(!response.headers.get('content-type')?.includes('application/json'))throw new Error('Sesija pasibaigė. Atnaujinkite puslapį.');const data=await response.json();if(!response.ok)throw new Error(data.message);location.reload();}catch(error){status.textContent=error.message;button.disabled=false;}});})();
</script>
