<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold"><%= mode === 'create' ? 'Nauja temų grupė' : 'Redaguoti temų grupę' %></h1>
    <p class="text-slate-600 mt-1">Naudojama temoms suskirstyti.</p>
  </div>
  <a class="underline" href="/admin/temu-grupes">Grįžti į sąrašą</a>
</div>

<% if (error) { %>
  <div class="mt-4 p-3 rounded border border-red-200 bg-red-50 text-red-800 text-sm"><%= error %></div>
<% } %>

<div class="grid lg:grid-cols-3 gap-4 mt-6">
  <div class="lg:col-span-2 bg-white border border-slate-200 rounded-lg p-6">
    <form method="post" action="<%= mode === 'create' ? '/admin/temu-grupes/nauja' : ('/admin/temu-grupes/' + group.id) %>" class="space-y-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-sm font-medium">Pavadinimas</label>
        <input name="title" class="mt-1 w-full px-3 py-2 rounded border border-slate-300" value="<%= group.title %>" />
      </div>
      <div>
        <label class="block text-sm font-medium">Aprašymas</label>
        <textarea name="description" class="mt-1 w-full px-3 py-2 rounded border border-slate-300" rows="3"><%= group.description || '' %></textarea>
      </div>
      <div class="grid sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium">Rikiavimo numeris</label>
          <input name="sort_order" class="mt-1 w-full px-3 py-2 rounded border border-slate-300" value="<%= group.sort_order %>" />
        </div>
        <div>
          <label class="block text-sm font-medium">Aktyvi</label>
          <select name="is_active" class="mt-1 w-full px-3 py-2 rounded border border-slate-300 bg-white">
            <option value="1" <%= group.is_active ? 'selected' : '' %>>Taip</option>
            <option value="0" <%= !group.is_active ? 'selected' : '' %>>Ne</option>
          </select>
        </div>
      </div>
      <button class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800"><%= mode === 'create' ? 'Sukurti' : 'Išsaugoti' %></button>
    </form>
  </div>

  <% if (mode === 'edit') { %>
    <div class="bg-white border border-slate-200 rounded-lg p-6">
      <div class="font-semibold text-red-700">Trinti grupę</div>
      <p class="text-sm text-slate-600 mt-1">Jei grupėje yra temų, trynimas gali nepavykti.</p>
      <form class="mt-3" method="post" action="/admin/temu-grupes/<%= group.id %>/trinti" onsubmit="return confirm('Tikrai trinti?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="px-3 py-2 rounded border border-red-300 text-red-700 hover:bg-red-50">Trinti</button>
      </form>
    </div>
  <% } %>
</div>

