<div class="flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold">Vartotojai</h1>
    <p class="text-slate-600 mt-1">Mokiniai ir administratoriai.</p>
  </div>
  <a class="px-3 py-2 rounded bg-slate-900 text-white hover:bg-slate-800" href="/admin/vartotojai/naujas">+ Naujas</a>
</div>

<div class="bg-white border border-slate-200 rounded-lg mt-6 overflow-x-auto">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-50 text-slate-600">
      <tr>
        <th class="text-left px-4 py-3">Vartotojo vardas</th>
        <th class="text-left px-4 py-3">Vardas / pavardė</th>
        <th class="text-left px-4 py-3">Rolė</th>
        <th class="text-left px-4 py-3">Aktyvus</th>
        <th class="text-left px-4 py-3">Atnaujinta</th>
        <th class="text-right px-4 py-3">Veiksmai</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach((u) => { %>
        <tr class="border-t border-slate-200">
          <td class="px-4 py-3 font-medium"><%= u.username %></td>
          <td class="px-4 py-3"><%= u.full_name %></td>
          <td class="px-4 py-3"><%= u.role === 'admin' ? 'Admin' : 'Mokinys' %></td>
          <td class="px-4 py-3"><%= u.is_active ? 'Taip' : 'Ne' %></td>
          <td class="px-4 py-3 text-slate-600"><%= u.updated_at %></td>
          <td class="px-4 py-3 text-right">
            <a class="underline" href="/admin/vartotojai/<%= u.id %>">Redaguoti</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

